# ---- copy this file to `.env` and fill in real values (`.env` is gitignored) ----

# 1) Supabase DATABASE connection string  -- NOT an API key.
#    Get it from the green "Connect" button (top bar) -> "Session pooler" tab.
#    Contains your DB password. Used only to load the schema + seed via psql.
DATABASE_URL="postgresql://postgres.pqhcdcadvdeufgpabvil:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# 2) Supabase SECRET key (sb_secret_...) from Settings -> API Keys.
#    Backend/Edge-Function use only (Day 4 agents). NEVER expose in the browser.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"

# 3) Google Gemini API key (https://aistudio.google.com/apikey) -- needed on Day 4.
GEMINI_API_KEY="AIza..."

# 4) Upload backend (agents/src/server.ts) -- all optional; defaults suit local dev.
#    Binds 127.0.0.1 and is UNAUTHENTICATED by design: it writes to the DB with
#    DATABASE_URL above and runs uploaded CSVs through the detector. Never expose it.
# PORT=8787
# MAX_UPLOAD_MB=300
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
