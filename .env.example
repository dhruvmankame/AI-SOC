# Copy to .env. Never commit real credentials.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="ai_soc"
GEMINI_API_KEY="YOUR-GEMINI-API-KEY"
GEMINI_MODEL="gemini-3.8-flash"
PORT=8787
MAX_UPLOAD_MB=300
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
AGENT_MAX_STEPS=18
AGENT_MAX_TOKENS=120000


# ---- LLM performance / provider selection ----
# Existing Gemini key works; Flash-Lite is tuned for short structured agent calls.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MIN_INTERVAL_SECONDS=4
AGENT_CONCURRENCY=1
MAX_AI_INCIDENTS=4

# Optional low-latency path. Create a GroqCloud key, then switch:
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-20b
# LLM_MIN_INTERVAL_SECONDS=0
# AGENT_CONCURRENCY=3
