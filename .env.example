# AI-SOC local configuration
# Copy this file to .env and fill in real credentials. Never commit .env.

MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="ai_soc"

# ---- LLM provider -----------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY="YOUR-GEMINI-API-KEY"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional Groq path:
# GROQ_API_KEY="gsk_your_key_here"
# GROQ_MODEL="openai/gpt-oss-20b"

# ---- Runtime ---------------------------------------------------------------
PORT=8787
MAX_UPLOAD_MB=300
CORS_ORIGIN="http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173"

# ---- Investigation controls ------------------------------------------------
AGENT_MAX_STEPS=18
AGENT_MAX_TOKENS=120000
MAX_AI_INCIDENTS=4

# Gemini-safe defaults:
LLM_MIN_INTERVAL_SECONDS=4
AGENT_CONCURRENCY=1

# Suggested Groq values:
# LLM_MIN_INTERVAL_SECONDS=0
# AGENT_CONCURRENCY=3
